<svg class="note-value-symbol"
     viewBox="0 0 64 96"
     role="img"
     aria-label="@AriaLabel">
    @if (Beats == 4)
    {
        <ellipse cx="32" cy="58" rx="20" ry="13" fill="none" stroke="currentColor" stroke-width="6" transform="rotate(-12 32 58)" />
    }
    else
    {
        <ellipse cx="25" cy="70" rx="15" ry="11"
                 fill="@(Beats == 1 ? "currentColor" : "none")"
                 stroke="currentColor"
                 stroke-width="5"
                 transform="rotate(-18 25 70)" />
        <line x1="38" y1="67" x2="38" y2="18" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
    }
</svg>

@code {
    [Parameter]
    public int Beats { get; set; }

    [Parameter]
    public string AriaLabel { get; set; } = string.Empty;
}
