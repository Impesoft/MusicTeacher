@using MusicTeacher.Shared.MusicTheory
@inject AppLocalizer Localizer

<div class="piano-keyboard-shell">
@if (LowerPressedCount > 0)
{
    <div class="midi-range-indicator is-lower" aria-live="polite">◀ @Localizer.Format("MidiLowerKeys", LowerPressedCount)</div>
}
<div class="piano-keyboard" role="group" aria-label="@Localizer["KeyboardAriaLabel"]">
    <div class="white-key-row">
        @foreach (var pitch in Pitches)
        {
            <button type="button"
                    class="@GetWhiteKeyClass(pitch)"
                    disabled="@IsDisabled"
                    data-pitch="@pitch.ScientificName"
                    aria-label="@GetPitchLabel(pitch)"
                    @onpointerenter="() => PreviewPitch(pitch)"
                    @onclick="() => SelectPitch(pitch)">
            </button>
        }
    </div>

    <div class="black-key-row">
        @foreach (var key in BlackKeys)
        {
            <button type="button"
                    class="@GetBlackKeyClass(key)"
                    disabled="@IsDisabled"
                    data-pitch="@key.SharpPitch.ScientificName"
                    aria-label="@GetBlackKeyLabel(key)"
                    style="@GetBlackKeyStyle(key.WhiteKeyIndex)"
                    @onpointerenter="() => PreviewPitch(key.SharpPitch)"
                    @onclick="() => SelectPitch(key.SharpPitch)">
                <span>@GetPrimaryNoteName(key.SharpPitch)</span>
                <span>@GetPrimaryNoteName(key.FlatPitch)</span>
                <small>@GetSecondaryNoteName(key.SharpPitch) / @GetSecondaryNoteName(key.FlatPitch)</small>
            </button>
        }
    </div>

    <div class="key-label-row" aria-hidden="true">
        @foreach (var pitch in Pitches)
        {
            <span class="key-label">
                <span>@GetPrimaryNoteName(pitch)</span>
                <small>@GetSecondaryNoteName(pitch)</small>
            </span>
        }
    </div>
</div>
@if (HigherPressedCount > 0)
{
    <div class="midi-range-indicator is-higher" aria-live="polite">@Localizer.Format("MidiHigherKeys", HigherPressedCount) ▶</div>
}
</div>

@code {
    [Parameter]
    public IReadOnlyList<Pitch> Pitches { get; set; } = [];

    [Parameter]
    public Pitch? HighlightedPitch { get; set; }

    [Parameter]
    public IReadOnlySet<int> PressedMidiNotes { get; set; } = new HashSet<int>();

    [Parameter]
    public int? DemonstratedMidiNote { get; set; }

    [Parameter]
    public bool IsDisabled { get; set; }

    [Parameter]
    public bool UseAlphabeticalNoteNames { get; set; }

    [Parameter]
    public EventCallback<Pitch> OnPitchPreviewed { get; set; }

    [Parameter]
    public EventCallback<Pitch> OnPitchSelected { get; set; }

    private IReadOnlyList<BlackPianoKey> BlackKeys => Pitches
        .Select((pitch, index) => new { pitch, index })
        .Where(item => HasBlackKeyAfter(item.pitch))
        .Select(item => new BlackPianoKey(
            item.index,
            new Pitch(item.pitch.Letter, item.pitch.Octave, Accidental.Sharp),
            GetFlatPitchAfter(item.pitch)))
        .ToArray();

    private async Task PreviewPitch(Pitch pitch) => await OnPitchPreviewed.InvokeAsync(pitch);

    private async Task SelectPitch(Pitch pitch) => await OnPitchSelected.InvokeAsync(pitch);

    private int LowestVisibleMidiNote => Pitches.Count == 0 ? 0 : Pitches.Min(pitch => pitch.MidiNote);

    private int HighestVisibleMidiNote => Pitches.Count == 0 ? 0 : Pitches.Max(pitch => pitch.MidiNote);

    private int LowerPressedCount => PressedMidiNotes.Count(note => note < LowestVisibleMidiNote);

    private int HigherPressedCount => PressedMidiNotes.Count(note => note > HighestVisibleMidiNote);

    private string GetWhiteKeyClass(Pitch pitch)
        => GetKeyClass("piano-white-key", pitch.MidiNote, HighlightedPitch == pitch);

    private string GetPitchLabel(Pitch pitch) => $"{GetPrimaryNoteName(pitch)} {GetSecondaryNoteName(pitch)}";

    private string GetBlackKeyClass(BlackPianoKey key)
        => GetKeyClass(
            "piano-black-key",
            key.SharpPitch.MidiNote,
            HighlightedPitch == key.SharpPitch || HighlightedPitch == key.FlatPitch);

    private string GetKeyClass(string baseClass, int midiNote, bool highlighted)
    {
        var classes = new List<string> { baseClass };
        if (highlighted) classes.Add("is-highlighted");
        if (DemonstratedMidiNote == midiNote) classes.Add("is-demonstrated");
        if (PressedMidiNotes.Contains(midiNote)) classes.Add("is-pressed");
        return string.Join(' ', classes);
    }

    private string GetBlackKeyLabel(BlackPianoKey key)
        => $"{GetPitchLabel(key.SharpPitch)}, {GetPitchLabel(key.FlatPitch)}";

    private string GetPrimaryNoteName(Pitch pitch)
        => UseAlphabeticalNoteNames ? pitch.ScientificName : GetFixedDoName(pitch);

    private string GetSecondaryNoteName(Pitch pitch)
        => UseAlphabeticalNoteNames ? GetFixedDoName(pitch) : pitch.ScientificName.ToLowerInvariant();

    private string GetFixedDoName(Pitch pitch)
        => Localizer.CurrentCulture.TwoLetterISOLanguageName == "nl" && pitch.Letter == NoteLetter.B
            ? $"si{GetAccidentalSymbol(pitch.Accidental)}"
            : pitch.FixedDoName;

    private static string GetAccidentalSymbol(Accidental accidental)
        => accidental switch
        {
            Accidental.Flat => "♭",
            Accidental.Natural => string.Empty,
            Accidental.Sharp => "♯",
            _ => throw new ArgumentOutOfRangeException(nameof(accidental), accidental, null)
        };

    private string GetBlackKeyStyle(int whiteKeyIndex)
    {
        var keyCount = Math.Max(Pitches.Count, 1);
        var left = ((whiteKeyIndex + 1d) / keyCount) * 100d;

        return FormattableString.Invariant($"left: calc({left:0.###}% - var(--black-key-width) / 2);");
    }

    private static bool HasBlackKeyAfter(Pitch pitch)
        => pitch.Accidental == Accidental.Natural && pitch.Letter is NoteLetter.C or NoteLetter.D or NoteLetter.F or NoteLetter.G or NoteLetter.A;

    private static Pitch GetFlatPitchAfter(Pitch pitch)
        => pitch.Letter switch
        {
            NoteLetter.C => new Pitch(NoteLetter.D, pitch.Octave, Accidental.Flat),
            NoteLetter.D => new Pitch(NoteLetter.E, pitch.Octave, Accidental.Flat),
            NoteLetter.F => new Pitch(NoteLetter.G, pitch.Octave, Accidental.Flat),
            NoteLetter.G => new Pitch(NoteLetter.A, pitch.Octave, Accidental.Flat),
            NoteLetter.A => new Pitch(NoteLetter.B, pitch.Octave, Accidental.Flat),
            _ => throw new ArgumentOutOfRangeException(nameof(pitch), pitch, null)
        };

    private sealed record BlackPianoKey(int WhiteKeyIndex, Pitch SharpPitch, Pitch FlatPitch);
}
