@page "/"
@using MusicTeacher.Shared.Lessons
@using MusicTeacher.Shared.MusicTheory
@using MusicTeacher.Shared.Progress
@inject HttpClient Http
@inject IProgressStore ProgressStore
@inject MusicAudioService Audio
@inject AppLocalizer Localizer
@inject IJSRuntime JS
@inject MidiInputService MidiInput
@implements IAsyncDisposable

<PageTitle>@Localizer["AppTitle"]</PageTitle>

@if (unlockToast is not null)
{
    <UnlockToast Title="@Localizer["UnlockToastTitle"]"
                 Message="@unlockToast.Message"
                 BadgeTitle="@unlockToast.BadgeTitle"
                 BadgeDescription="@unlockToast.BadgeDescription"
                 BadgeIcon="@unlockToast.BadgeIcon"
                 DismissLabel="@Localizer["DismissToast"]"
                 OnDismiss="DismissUnlockToast" />
}

@if (!hasStarted)
{
    <section class="start-screen">
        <div class="start-card">
            <div class="profile-header-card">
                <div class="profile-avatar-area">
                    <AvatarPortrait Avatar="@selectedAvatar" Size="large" IsAnimated="true" />
                    <button class="customize-trigger-button" type="button" @onclick="OpenCustomizer">
                        🎨 @Localizer["CustomizerEditButton"]
                    </button>
                </div>
                <div class="profile-details-area">
                    <div class="lesson-kicker">@(lesson is null ? string.Empty : Localizer["TrebleClefKicker"])</div>
                    <h1>@Localizer["ProfileWelcome"]</h1>
                    <p class="profile-welcome-intro">@Localizer["StartScreenIntro"]</p>
                    <div class="profile-meta-badges">
                        <span class="meta-badge">
                            🌐 @(Localizer.CurrentCulture.Name.StartsWith("nl", StringComparison.OrdinalIgnoreCase) ? "Nederlands" : "English")
                        </span>
                        <span class="meta-badge">
                            🎵 @(UseAlphabeticalNoteNames ? Localizer["NoteNameModeAlphabetical"] : Localizer["NoteNameModeFixedDo"])
                        </span>
                    </div>
                </div>
            </div>

            <div class="start-options" aria-label="@Localizer["PracticeModeLabel"]">
                <button class="start-option-card"
                        type="button"
                        @onclick="() => StartPractice(PracticeMode.FreeExplore)">
                    <strong>@Localizer["FreeExploreMode"]</strong>
                    <small>@Localizer["FreeExploreDescription"]</small>
                </button>
                <button class="start-option-card is-primary"
                        type="button"
                        @onclick="() => StartPractice(PracticeMode.LearningPath)">
                    <strong>@Localizer["LearningMode"]</strong>
                    <small>@Localizer["LearningModeDescription"]</small>
                </button>
                <button class="start-option-card"
                        type="button"
                        @onclick="() => StartPractice(PracticeMode.Theory)">
                    <strong>@Localizer["TheoryMode"]</strong>
                    <small>@Localizer["TheoryModeDescription"]</small>
                </button>
            </div>

            @if (MidiInput.IsSupported)
            {
                <button class="midi-invitation @(MidiInput.IsListening ? "is-connected" : null)"
                        type="button"
                        @onclick="OpenMidiSettings">
                    <span class="midi-invitation-icon" aria-hidden="true">@(MidiInput.IsListening ? "✓" : "🎹")</span>
                    <span>
                        <strong>@Localizer[MidiInput.IsListening ? "MidiInvitationConnectedTitle" : "MidiInvitationTitle"]</strong>
                        <small>@Localizer[MidiInput.IsListening ? "MidiInvitationConnectedDescription" : "MidiInvitationDescription"]</small>
                    </span>
                    <span class="midi-invitation-action">
                        @Localizer[MidiInput.IsListening ? "MidiInvitationManageAction" : "MidiInvitationAction"] →
                    </span>
                </button>
            }
        </div>
    </section>
}
else if (practiceMode == PracticeMode.Theory)
{
    <section class="theory-stage">
        <div class="lesson-panel theory-panel">
            <div class="avatar-chip" aria-label="@Localizer["SelectedAvatarLabel"]">
                <AvatarPortrait Avatar="@selectedAvatar" Size="small" />
            </div>
            <div class="lesson-kicker">@Localizer["TheoryKicker"]</div>
            <h1>@Localizer["TheoryTitle"]</h1>

            <button class="back-to-start-button" type="button" @onclick="ReturnToStart">
                @Localizer["BackToStart"]
            </button>
            @if (MidiInput.IsSupported)
            {
                <button class="midi-practice-shortcut" type="button" @onclick="OpenMidiSettings">
                    🎹 @(MidiInput.IsListening ? Localizer["MidiConnectedShort"] : Localizer["MidiConnectShort"])
                </button>
            }

            <div class="level-card" aria-live="polite">
                <div class="level-card-header">
                    <span>@Localizer["TheoryTopicLabel"]</span>
                    <span>@Localizer.Format("TheoryPageCounter", theoryPageIndex + 1, AvailableTheoryPages.Count)</span>
                </div>
                <strong>@CurrentTheoryTitle</strong>
                <small>@CurrentTheorySummary</small>
            </div>
        </div>

        <div class="exercise-board theory-board">
            <div class="prompt-row">
                <div>
                    <p class="prompt-label">@Localizer["TheoryMode"]</p>
                    <h2>@CurrentTheoryTitle</h2>
                </div>
                <div class="prompt-actions">
                    <button class="next-button secondary-button"
                            type="button"
                            disabled="@IsFirstTheoryPage"
                            @onclick="PreviousTheoryPage"
                            aria-label="@Localizer["PreviousTheoryPage"]">
                        <span class="theory-nav-text">@Localizer["Previous"]</span>
                        <span class="theory-nav-icon" aria-hidden="true">‹</span>
                    </button>
                    <button class="next-button"
                            type="button"
                            disabled="@IsLastTheoryPage"
                            @onclick="NextTheoryPage"
                            aria-label="@Localizer["NextTheoryPage"]">
                        <span class="theory-nav-text">@Localizer["Next"]</span>
                        <span class="theory-nav-icon" aria-hidden="true">›</span>
                    </button>
                </div>
            </div>

            <p class="theory-copy">@CurrentTheoryBody</p>

            @if (CurrentTheoryPage.Visual == TheoryVisual.Staff)
            {
                <div class="theory-visual">
                    <MusicStaff UseAlphabeticalNoteNames="@UseAlphabeticalNoteNames" />
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.TrebleClef)
            {
                <div class="theory-visual">
                    <MusicStaff DisplayedPitch="@(new Pitch(NoteLetter.G, 4))"
                                UseAlphabeticalNoteNames="@UseAlphabeticalNoteNames" />
                    <p class="theory-callout">@Localizer["TheoryTrebleClefCallout"]</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.SingleNote && CurrentTheoryPage.Pitch is { } theoryPitch)
            {
                <div class="theory-visual">
                    <MusicStaff DisplayedPitch="@theoryPitch"
                                UseAlphabeticalNoteNames="@UseAlphabeticalNoteNames" />
                    <p class="theory-callout">@Localizer.Format("TheorySingleNoteCallout", GetPromptName(theoryPitch), theoryPitch.ScientificName.ToLowerInvariant())</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.Keyboard)
            {
                <div class="theory-visual">
                    <PianoKeyboard Pitches="@TrebleClef.BeginnerReadingNotes"
                                   UseAlphabeticalNoteNames="@UseAlphabeticalNoteNames" />
                    <p class="theory-callout">@Localizer["TheoryBlackKeysCallout"]</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.Beat)
            {
                <div class="theory-visual beat-theory-visual">
                    <div class="beat-pulse-row" aria-label="@Localizer["TheorySteadyBeatPatternLabel"]">
                        @for (var beat = 1; beat <= 4; beat++)
                        {
                            <div class="beat-pulse">
                                <span aria-hidden="true">●</span>
                                <strong>@beat</strong>
                            </div>
                        }
                    </div>
                    <p class="theory-callout">@Localizer["TheorySteadyBeatCallout"]</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.DurationContrast)
            {
                <div class="theory-visual duration-theory-visual">
                    <div class="duration-example" aria-label="@Localizer["TheoryShortSoundPatternLabel"]">
                        <strong>@Localizer["TheoryShortSoundLabel"]</strong>
                        <div class="duration-beat-grid" aria-hidden="true">
                            <span class="duration-block is-sounding"></span>
                            <span></span>
                            <span></span>
                            <span></span>
                        </div>
                        <small>@Localizer["TheoryShortSoundCount"]</small>
                    </div>
                    <div class="duration-example" aria-label="@Localizer["TheoryLongSoundPatternLabel"]">
                        <strong>@Localizer["TheoryLongSoundLabel"]</strong>
                        <div class="duration-beat-grid" aria-hidden="true">
                            <span class="duration-block is-sounding"></span>
                            <span class="duration-block is-sounding"></span>
                            <span class="duration-block is-sounding"></span>
                            <span class="duration-block is-sounding"></span>
                        </div>
                        <small>@Localizer["TheoryLongSoundCount"]</small>
                    </div>
                    <p class="theory-callout">@Localizer["TheorySoundLengthCallout"]</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.BeatDurations)
            {
                <div class="theory-visual beat-duration-theory-visual">
                    @foreach (var beatLength in new[] { 1, 2, 4 })
                    {
                        <div class="duration-example"
                             aria-label="@Localizer[$"TheoryBeatDuration{beatLength}PatternLabel"]">
                            <strong>@Localizer.Format("TheoryBeatDurationLabel", beatLength)</strong>
                            <div class="duration-beat-grid" aria-hidden="true">
                                @for (var beat = 1; beat <= 4; beat++)
                                {
                                    <span class="@(beat <= beatLength ? "duration-block is-sounding" : null)"></span>
                                }
                            </div>
                            <small>@Localizer[$"TheoryBeatDuration{beatLength}Count"]</small>
                            <button class="duration-listen-button"
                                    type="button"
                                    @onclick="() => PlayTheoryDuration(beatLength)">
                                @Localizer.Format("TheoryListenForBeats", beatLength)
                            </button>
                        </div>
                    }
                    <p class="theory-callout">@Localizer["TheoryBeatDurationsCallout"]</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.NoteValues)
            {
                <div class="theory-visual note-values-theory-visual">
                    @foreach (var beatLength in new[] { 1, 2, 4 })
                    {
                        <div class="note-value-card">
                            <NoteValueSymbol Beats="@beatLength"
                                             AriaLabel="@Localizer[$"TheoryNoteValue{beatLength}SymbolLabel"]" />
                            <div>
                                <strong>@Localizer[$"TheoryNoteValue{beatLength}Name"]</strong>
                                <span>@Localizer.Format("TheoryBeatDurationLabel", beatLength)</span>
                            </div>
                            <button class="duration-listen-button"
                                    type="button"
                                    @onclick="() => PlayTheoryDuration(beatLength)">
                                @Localizer.Format("TheoryListenForBeats", beatLength)
                            </button>
                        </div>
                    }
                    <p class="theory-callout">@Localizer["TheoryNoteValuesCallout"]</p>
                </div>
            }
            else if (CurrentTheoryPage.Visual == TheoryVisual.Rests)
            {
                <div class="theory-visual rests-theory-visual">
                    <div class="rest-pattern"
                         role="group"
                         aria-label="@Localizer["TheoryRestPatternLabel"]">
                        @for (var beat = 1; beat <= 4; beat++)
                        {
                            var isSound = beat is 1 or 3;
                            <div class="rest-beat @(isSound ? "is-sound" : "is-rest") @(activeRestExampleBeat == beat ? "is-active" : null)">
                                <strong>@beat</strong>
                                @if (isSound)
                                {
                                    <NoteValueSymbol Beats="1" AriaLabel="@Localizer["TheoryNoteValue1SymbolLabel"]" />
                                    <span>@Localizer["TheoryRestSoundLabel"]</span>
                                }
                                else
                                {
                                    <span class="rest-silence-mark" aria-hidden="true">…</span>
                                    <span>@Localizer["TheoryRestSilenceLabel"]</span>
                                }
                            </div>
                        }
                    </div>
                    <button class="duration-listen-button"
                            type="button"
                            disabled="@(activeRestExampleBeat > 0)"
                            @onclick="PlayTheoryRestPattern">
                        @Localizer["TheoryRestListen"]
                    </button>
                    <p class="theory-callout">@Localizer["TheoryRestsCallout"]</p>
                </div>
            }
        </div>
    </section>
}
else
{
    <section class="practice-stage">
        <div class="lesson-panel">
            <div class="avatar-chip" aria-label="@Localizer["SelectedAvatarLabel"]">
                <AvatarPortrait Avatar="@selectedAvatar" Size="small" />
            </div>
            <div class="lesson-kicker">@(lesson is null ? string.Empty : Localizer["TrebleClefKicker"])</div>
            <h1>@Localizer["TrebleClefStartTitle"]</h1>

            <button class="back-to-start-button" type="button" @onclick="ReturnToStart">
                @Localizer["BackToStart"]
            </button>
            @if (MidiInput.IsSupported)
            {
                <button class="midi-practice-shortcut" type="button" @onclick="OpenMidiSettings">
                    🎹 @(MidiInput.IsListening ? Localizer["MidiConnectedShort"] : Localizer["MidiConnectShort"])
                </button>
            }

            <nav class="mode-switch" aria-label="@Localizer["DrillModeLabel"]">
                <section class="mode-group mode-group-basics" aria-labelledby="mode-group-basics">
                    <h2 id="mode-group-basics">@Localizer["LearningPathBasics"]</h2>
                    <div class="mode-group-buttons">
                        <button class="@GetModeClass(DrillMode.NameNote)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.NameNote)"
                                @onclick="() => SetMode(DrillMode.NameNote)">
                            @Localizer["NameMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.PlaceNote)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.PlaceNote)"
                                @onclick="() => SetMode(DrillMode.PlaceNote)">
                            @Localizer["PlaceMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.HearNotePlay)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.HearNotePlay)"
                                @onclick="() => SetMode(DrillMode.HearNotePlay)">
                            @Localizer["HearPlayMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.HearNotePlace)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.HearNotePlace)"
                                @onclick="() => SetMode(DrillMode.HearNotePlace)">
                            @Localizer["HearPlaceMode"]
                        </button>
                    </div>
                </section>

                <section class="mode-group mode-group-melody" aria-labelledby="mode-group-melody">
                    <h2 id="mode-group-melody">@Localizer["LearningPathMelody"]</h2>
                    <div class="mode-group-buttons">
                        <button class="@GetModeClass(DrillMode.MelodyEcho)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.MelodyEcho)"
                                @onclick="() => SetMode(DrillMode.MelodyEcho)">
                            @Localizer["MelodyEchoMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.MelodyEchoLong)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.MelodyEchoLong)"
                                @onclick="() => SetMode(DrillMode.MelodyEchoLong)">
                            @Localizer["MelodyEchoLongMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.StaffPhrasePitch)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.StaffPhrasePitch)"
                                @onclick="() => SetMode(DrillMode.StaffPhrasePitch)">
                            @Localizer["StaffPhraseMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.WrittenMeasureTwoFour)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.WrittenMeasureTwoFour)"
                                @onclick="() => SetMode(DrillMode.WrittenMeasureTwoFour)">
                            @Localizer["WrittenMeasureMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.WrittenMeasureFourFour)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.WrittenMeasureFourFour)"
                                @onclick="() => SetMode(DrillMode.WrittenMeasureFourFour)">
                            @Localizer["TimedMeasureMode"]
                        </button>
                    </div>
                </section>

                <section class="mode-group mode-group-rhythm" aria-labelledby="mode-group-rhythm">
                    <h2 id="mode-group-rhythm">@Localizer["LearningPathRhythm"]</h2>
                    <div class="mode-group-buttons">
                        <button class="@GetModeClass(DrillMode.BeatTap)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.BeatTap)"
                                @onclick="() => SetMode(DrillMode.BeatTap)">
                            @Localizer["BeatTapMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.HoldDuration)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.HoldDuration)"
                                @onclick="() => SetMode(DrillMode.HoldDuration)">
                            @Localizer["DurationHoldMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.RhythmEcho)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.RhythmEcho)"
                                @onclick="() => SetMode(DrillMode.RhythmEcho)">
                            @Localizer["RhythmEchoMode"]
                        </button>
                    </div>
                </section>

                <section class="mode-group mode-group-accidentals" aria-labelledby="mode-group-accidentals">
                    <h2 id="mode-group-accidentals">@Localizer["LearningPathAccidentals"]</h2>
                    <div class="mode-group-buttons">
                        <button class="@GetModeClass(DrillMode.NameAccidental)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.NameAccidental)"
                                @onclick="() => SetMode(DrillMode.NameAccidental)">
                            @Localizer["NameAccidentalMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.PlaceAccidental)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.PlaceAccidental)"
                                @onclick="() => SetMode(DrillMode.PlaceAccidental)">
                            @Localizer["PlaceAccidentalMode"]
                        </button>
                        <button class="@GetModeClass(DrillMode.HearAccidentalPlay)"
                                type="button"
                                disabled="@IsModeLocked(DrillMode.HearAccidentalPlay)"
                                @onclick="() => SetMode(DrillMode.HearAccidentalPlay)">
                            @Localizer["HearAccidentalPlayMode"]
                        </button>
                    </div>
                </section>
            </nav>

            @if (practiceMode == PracticeMode.LearningPath)
            {
                <div class="level-card" aria-live="polite">
                    <div class="level-card-header">
                        <span>@Localizer.Format("LearningLevelLabel", CurrentLevelNumber)</span>
                        <button class="reset-progress-button" type="button" @onclick="ResetProgress">
                            @Localizer["ResetProgress"]
                        </button>
                    </div>
                    <strong>@CurrentDrillTitle</strong>
                    <small>@LearningGoalText</small>
                </div>
            }

            <div class="score-strip" aria-live="polite">
                <span>@Localizer.Format("ScoreCorrect", DisplayCorrectAnswers)</span>
                <span>@Localizer.Format("ScoreTries", DisplayAttempts)</span>
                <span>@Localizer.Format("ScoreStreak", DisplayStreak)</span>
            </div>

            <div class="badge-shelf" aria-label="@Localizer["BadgeShelfLabel"]">
                <div class="badge-shelf-header">@Localizer["BadgeShelfLabel"]</div>
                @if (EarnedBadges.Count == 0)
                {
                    <div class="badge-empty">@Localizer["BadgeShelfEmpty"]</div>
                }
                else
                {
                    <div class="badge-grid">
                        @foreach (var badge in EarnedBadges)
                        {
                            <div class="earned-badge" title="@Localizer[badge.DescriptionKey]">
                                <span>@badge.Icon</span>
                                <small>@Localizer[badge.TitleKey]</small>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="exercise-board">
            <div class="prompt-row">
                <div>
                    <p class="prompt-label">@CurrentDrillTitle</p>
                    <h2>@PromptText</h2>
                </div>
                <div class="prompt-actions">
                    @if (IsHearingMode)
                    {
                        <button class="listen-button" type="button" @onclick="PlayAssignmentNote" aria-label="@Localizer["PlayAssignmentNote"]">
                            @Localizer["PlayAssignmentNote"]
                        </button>
                    }
                    else if (IsMelodyEchoMode)
                    {
                        <button class="listen-button"
                                type="button"
                                disabled="@isDemonstratingMelody"
                                @onclick="DemonstrateMelodyPhrase">
                            @Localizer["MelodyEchoReplay"]
                        </button>
                    }
                    <button class="next-button" type="button" @onclick="AdvanceRound" aria-label="@Localizer["NextNote"]">@Localizer["Next"]</button>
                </div>
            </div>

            @if (ShowsStaff)
            {
                <MusicStaff DisplayedPitch="@DisplayedPitch"
                            IsPlacementMode="@IsPlacementMode"
                            SelectableSteps="@SelectableSteps"
                            SelectedStep="@selectedStep"
                            PhrasePitches="@(IsStaffPhraseMode ? staffPhrase.Pitches : IsWrittenMeasureMode ? WrittenMeasurePitches : IsTimedWrittenMeasureMode ? TimedMeasurePitches : Array.Empty<Pitch>())"
                            PhraseTimeSignature="@(IsWrittenMeasureMode ? writtenMeasure.TimeSignature : IsTimedWrittenMeasureMode ? timedWrittenMeasure.TimeSignature : null)"
                            CurrentPhraseIndex="@(IsWrittenMeasureMode ? WrittenMeasurePosition : IsTimedWrittenMeasureMode ? TimedMeasurePosition : StaffPhrasePosition)"
                            UseAlphabeticalNoteNames="@UseAlphabeticalNoteNames"
                            OnStepPreviewed="PreviewStaffStep"
                            OnStepSelected="SelectStaffStep" />
            }

            @if (IsBeatTapMode)
            {
                <div class="beat-tap-stage">
                    <div class="beat-tap-pulse @(isBeatTapActive ? "is-active" : null)" aria-hidden="true">
                        @(beatCountIn > 0 ? beatCountIn : "●")
                    </div>
                    <div class="beat-tap-progress"
                         role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="@RequiredBeatTaps"
                         aria-valuenow="@BeatTapCount"
                         aria-label="@Localizer["BeatTapProgressLabel"]">
                        @for (var tapIndex = 0; tapIndex < RequiredBeatTaps; tapIndex++)
                        {
                            <span class="@(tapIndex < BeatTapCount ? "is-complete" : null)" aria-hidden="true"></span>
                        }
                        <small>@Localizer.Format("BeatTapProgress", BeatTapCount, RequiredBeatTaps)</small>
                    </div>
                    @if (!isBeatTapActive)
                    {
                        <button class="beat-start-button"
                                type="button"
                                disabled="@(beatCountIn > 0)"
                                @onclick="StartBeatRound">
                            @(beatCountIn > 0 ? Localizer["BeatTapCountIn"] : Localizer["BeatTapStart"])
                        </button>
                    }
                    else
                    {
                        <button class="beat-tap-button" type="button" @onclick="RegisterBeatTap">
                            @Localizer["BeatTapButton"]
                            <small>@Localizer["BeatTapInputHint"]</small>
                        </button>
                    }
                </div>
            }

            @if (IsDurationHoldMode)
            {
                <div class="duration-hold-stage">
                    <div class="duration-metronome-count @(durationCountIn > 0 ? "is-counting" : null)"
                         aria-live="polite">
                        @(durationCountIn > 0 ? durationCountIn.ToString() : "●")
                    </div>
                    <div class="duration-hold-target">
                        <NoteValueSymbol Beats="@requestedDurationBeats"
                                         AriaLabel="@Localizer[$"TheoryNoteValue{requestedDurationBeats}SymbolLabel"]" />
                        <strong>@Localizer.Format("DurationHoldTarget", requestedDurationBeats)</strong>
                    </div>
                    <div class="duration-hold-ruler"
                         role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="4"
                         aria-valuenow="@DurationProgressBeats"
                         aria-label="@Localizer["DurationHoldProgressLabel"]">
                        <span style="@DurationProgressStyle"></span>
                        @for (var beat = 1; beat <= 4; beat++)
                        {
                            <i class="@(beat <= requestedDurationBeats ? "is-expected" : "is-resting")"
                               aria-hidden="true">@beat</i>
                        }
                    </div>
                    @if (!isDurationReadyToHold)
                    {
                        <button class="duration-count-in-button"
                                type="button"
                                disabled="@(durationCountIn > 0)"
                                @onclick="StartDurationCountIn">
                            @(durationCountIn > 0 ? Localizer["DurationHoldListen"] : Localizer["DurationHoldStartCountIn"])
                        </button>
                    }
                    else
                    {
                        <button class="duration-hold-button @(isHoldingDuration ? "is-holding" : null)"
                                type="button"
                                aria-pressed="@isHoldingDuration"
                                @onpointerdown="() => StartDurationHold()"
                                @onpointerup="() => EndDurationHold()"
                                @onpointercancel="() => EndDurationHold()"
                                @onpointerleave="() => EndDurationHold()"
                                @onkeydown="HandleDurationKeyDown"
                                @onkeyup="HandleDurationKeyUp"
                                @onkeydown:preventDefault>
                            @(isHoldingDuration ? Localizer["DurationHoldReleaseButton"] : Localizer["DurationHoldPressButton"])
                            <small>@Localizer["DurationHoldInputHint"]</small>
                        </button>
                    }
                </div>
            }

            @if (IsRhythmEchoMode)
            {
                <div class="rhythm-echo-stage">
                    <div class="rhythm-echo-pattern"
                         role="group"
                         aria-label="@Localizer["RhythmEchoPatternLabel"]">
                        @for (var beat = 0; beat < 4; beat++)
                        {
                            var isSoundBeat = rhythmPattern.Contains(beat);
                            <div class="rhythm-echo-beat @(isSoundBeat ? "is-sound" : "is-rest") @(rhythmActiveBeat == beat + 1 ? "is-active" : null)"
                                 data-beat="@(beat + 1)"
                                 data-sound="@isSoundBeat.ToString().ToLowerInvariant()">
                                <strong>@(beat + 1)</strong>
                                <span>@(isSoundBeat ? Localizer["TheoryRestSoundLabel"] : Localizer["TheoryRestSilenceLabel"])</span>
                            </div>
                        }
                    </div>
                    <button class="rhythm-echo-action-button @(isRhythmInputActive ? "is-input-active" : null)"
                            type="button"
                            disabled="@isDemonstratingRhythm"
                            @onclick="HandleRhythmAction">
                        @(isDemonstratingRhythm
                            ? Localizer["RhythmEchoListening"]
                            : isRhythmInputActive
                                ? Localizer["RhythmEchoTap"]
                                : Localizer["RhythmEchoStart"])
                        <small>
                            @(isRhythmInputActive
                                ? Localizer["RhythmEchoInputHint"]
                                : Localizer["RhythmEchoStartHint"])
                        </small>
                    </button>
                </div>
            }

            @if (ShowsAccidentalSelector)
            {
                <div class="accidental-selector" role="group" aria-label="@Localizer["AccidentalSelectorLabel"]">
                    <span>@Localizer["AccidentalSelectorLabel"]</span>
                    <button class="@GetAccidentalButtonClass(Accidental.Flat)"
                            type="button"
                            disabled="@(!CanChooseAccidental)"
                            aria-label="@Localizer["AccidentalFlat"]"
                            @onclick="() => SetSelectedAccidental(Accidental.Flat)">♭</button>
                    <button class="@GetAccidentalButtonClass(Accidental.Natural)"
                            type="button"
                            disabled="@(!CanChooseAccidental)"
                            aria-label="@Localizer["AccidentalNatural"]"
                            @onclick="() => SetSelectedAccidental(Accidental.Natural)">♮</button>
                    <button class="@GetAccidentalButtonClass(Accidental.Sharp)"
                            type="button"
                            disabled="@(!CanChooseAccidental)"
                            aria-label="@Localizer["AccidentalSharp"]"
                            @onclick="() => SetSelectedAccidental(Accidental.Sharp)">♯</button>
                    <small>@(CanChooseAccidental ? Localizer["AccidentalSelectorHint"] : Localizer["AccidentalSelectorDisabledHint"])</small>
                </div>
            }

            @if (ShowsKeyboard)
            {
                @if (IsMelodyEchoMode)
                {
                    <div class="melody-echo-progress"
                         role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="@MelodyLength"
                         aria-valuenow="@MelodyPosition"
                         aria-label="@Localizer["MelodyEchoProgressLabel"]">
                        @for (var noteIndex = 0; noteIndex < MelodyLength; noteIndex++)
                        {
                            <span class="@(noteIndex < MelodyPosition ? "is-complete" : null)" aria-hidden="true">♪</span>
                        }
                        <small>@Localizer.Format("MelodyEchoProgress", MelodyPosition, MelodyLength)</small>
                    </div>
                }
                else if (IsStaffPhraseMode)
                {
                    <div class="melody-echo-progress"
                         role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="@StaffPhraseLength"
                         aria-valuenow="@StaffPhrasePosition"
                         aria-label="@Localizer["StaffPhraseProgressLabel"]">
                        @for (var noteIndex = 0; noteIndex < StaffPhraseLength; noteIndex++)
                        {
                            <span class="@(noteIndex < StaffPhrasePosition ? "is-complete" : null)" aria-hidden="true">♪</span>
                        }
                        <small>@Localizer.Format("StaffPhraseProgress", StaffPhrasePosition, StaffPhraseLength)</small>
                    </div>
                }
                else if (IsWrittenMeasureMode)
                {
                    <div class="melody-echo-progress"
                         role="progressbar"
                         aria-valuemin="0"
                         aria-valuemax="@writtenMeasure.Notes.Count"
                         aria-valuenow="@WrittenMeasurePosition"
                         aria-label="@Localizer["WrittenMeasureProgressLabel"]">
                        @for (var noteIndex = 0; noteIndex < writtenMeasure.Notes.Count; noteIndex++)
                        {
                            <span class="@(noteIndex < WrittenMeasurePosition ? "is-complete" : null)" aria-hidden="true">♩</span>
                        }
                        <small>@Localizer.Format("WrittenMeasureProgress", WrittenMeasurePosition, writtenMeasure.Notes.Count)</small>
                    </div>
                }
                else if (IsTimedWrittenMeasureMode)
                {
                    <div class="timed-measure-stage">
                        <div class="timed-measure-beats"
                             role="progressbar"
                             aria-valuemin="0"
                             aria-valuemax="4"
                             aria-valuenow="@TimedMeasurePosition"
                             aria-label="@Localizer["TimedMeasureProgressLabel"]">
                            @for (var beat = 1; beat <= 4; beat++)
                            {
                                <span class="@(beat <= TimedMeasurePosition ? "is-complete" : null) @(timedMeasureActiveBeat == beat ? "is-active" : null)"
                                      data-beat="@beat">
                                    <strong>@beat</strong>
                                    <small>♩</small>
                                </span>
                            }
                        </div>
                        <button class="rhythm-echo-action-button"
                                type="button"
                                disabled="@(timedMeasureCountIn > 0 || isTimedMeasureInputActive)"
                                @onclick="StartTimedMeasureCountIn">
                            @(timedMeasureCountIn > 0
                                ? Localizer.Format("TimedMeasureCountInButton", timedMeasureCountIn)
                                : isTimedMeasureInputActive
                                    ? Localizer["TimedMeasurePlaying"]
                                    : Localizer["TimedMeasureStart"])
                            <small>@Localizer["TimedMeasureInputHint"]</small>
                        </button>
                    </div>
                }
                <PianoKeyboard Pitches="@CurrentKeyboardPitches"
                               HighlightedPitch="@KeyboardHighlightedPitch"
                               PressedMidiNotes="@KeyboardPressedNotes"
                               DemonstratedMidiNote="@teacherDemonstratedMidiNote"
                               IsDisabled="@KeyboardInputDisabled"
                               UsePressReleaseInput="@UsesWrittenMeasureInput"
                               UseAlphabeticalNoteNames="@UseAlphabeticalNoteNames"
                               OnPitchPreviewed="PreviewPitch"
                               OnPitchSelected="SelectKeyboardPitch"
                               OnPitchPressed="StartPracticeMeasureNote"
                               OnPitchReleased="EndPracticeMeasureNote" />
            }

            <div class="@feedbackClass" aria-live="polite">@FeedbackText</div>
        </div>
    </section>
}

@if (isCustomizerOpen)
{
    <div class="customizer-overlay" @onclick="CloseCustomizer" role="dialog" aria-modal="true">
        <div class="customizer-modal" @onclick:stopPropagation>
            <div class="customizer-header">
                <h2>🎨 @Localizer["CustomizeProfileTitle"]</h2>
                <button class="close-modal-button" type="button" @onclick="CloseCustomizer" aria-label="@Localizer["CloseLabel"]">×</button>
            </div>

            <div class="customizer-tabs" role="tablist">
                <button class="@GetTabClass(CustomizerTab.Avatar)" type="button" role="tab" @onclick="() => SetCustomizerTab(CustomizerTab.Avatar)">
                    @Localizer["TabAvatar"]
                </button>
                <button class="@GetTabClass(CustomizerTab.Theme)" type="button" role="tab" @onclick="() => SetCustomizerTab(CustomizerTab.Theme)">
                    @Localizer["TabTheme"]
                </button>
                <button class="@GetTabClass(CustomizerTab.Settings)" type="button" role="tab" @onclick="() => SetCustomizerTab(CustomizerTab.Settings)">
                    @Localizer["TabSettings"]
                </button>
            </div>

            <div class="customizer-content">
                @if (activeCustomizerTab == CustomizerTab.Avatar)
                {
                    <div class="avatar-selection-grid">
                        @foreach (var option in AvatarOptions)
                        {
                            var activeClass = GetAvatarClass(option.Value);
                            <button class="@activeClass"
                                    type="button"
                                    aria-label="@Localizer[option.LabelKey]"
                                    @onclick="() => SetAvatar(option.Value)">
                                <AvatarPortrait Avatar="@option.Value" Size="medium" />
                                <span class="avatar-name">@Localizer[option.LabelKey].Replace(" avatar", "")</span>
                            </button>
                        }
                    </div>
                }
                else if (activeCustomizerTab == CustomizerTab.Theme)
                {
                    <div class="theme-selection-grid">
                        @foreach (var option in VisualThemeOptions)
                        {
                            var activeClass = GetVisualThemeClass(option.Value);
                            <button class="@activeClass"
                                    type="button"
                                    @onclick="() => SetVisualTheme(option.Value)">
                                <span class="theme-preview theme-@option.Value"></span>
                                <span class="theme-name">@Localizer[option.LabelKey]</span>
                            </button>
                        }
                    </div>
                }
                else if (activeCustomizerTab == CustomizerTab.Settings)
                {
                    <div class="settings-pane">
                        <div class="setting-item">
                            <span class="setting-label">@Localizer["NoteNameModeLabel"]</span>
                            <div class="choice-switcher" role="group" aria-label="@Localizer["NoteNameModeLabel"]">
                                <button class="@GetNoteNameModeClass(NoteNameMode.FixedDo)"
                                        type="button"
                                        @onclick="() => SetNoteNameMode(NoteNameMode.FixedDo)">
                                    @Localizer["NoteNameModeFixedDo"]
                                </button>
                                <button class="@GetNoteNameModeClass(NoteNameMode.Alphabetical)"
                                        type="button"
                                        @onclick="() => SetNoteNameMode(NoteNameMode.Alphabetical)">
                                    @Localizer["NoteNameModeAlphabetical"]
                                </button>
                            </div>
                        </div>

                        <div class="setting-item">
                            <label class="setting-label" for="midi-input-device">@Localizer["MidiInputLabel"]</label>
                            @if (!MidiInput.IsSupported)
                            {
                                <p class="setting-help">@Localizer["MidiUnsupported"]</p>
                            }
                            else if (!midiAccessRequested)
                            {
                                <button class="choice-button" type="button" @onclick="RequestMidiAccess">
                                    @Localizer["MidiEnable"]
                                </button>
                            }
                            else
                            {
                                @if (MidiInput.AccessFailed)
                                {
                                    <p class="setting-help">@Localizer["MidiAccessFailed"]</p>
                                    <button class="choice-button" type="button" @onclick="RequestMidiAccess">
                                        @Localizer["MidiRetry"]
                                    </button>
                                }
                                <select id="midi-input-device"
                                        class="midi-device-select"
                                        disabled="@MidiInput.AccessFailed"
                                        value="@SelectedMidiDeviceValue"
                                        @onchange="ChangeMidiDevice">
                                    <option value="">@Localizer["MidiOff"]</option>
                                    @foreach (var device in MidiInput.Devices)
                                    {
                                        <option value="@device.Id">@device.Name</option>
                                    }
                                </select>
                                <p class="setting-help">@MidiStatusText</p>
                                @if (MidiInput.SelectedDeviceId is not null)
                                {
                                    <div class="midi-input-monitor @(MidiInput.LastMidiNote is null ? null : "has-input")"
                                         aria-live="polite">
                                        <span class="midi-monitor-light" aria-hidden="true"></span>
                                        <span>@MidiMonitorText</span>
                                    </div>
                                    <button class="midi-diagnostic-button" type="button" @onclick="RefreshMidiDiagnostics">
                                        @Localizer["MidiCheckSignal"]
                                    </button>
                                    @if (MidiInput.BrowserDiagnostics is not null)
                                    {
                                        <p class="midi-diagnostic-result">@MidiBrowserDiagnosticText</p>
                                    }
                                }
                            }
                        </div>

                        <div class="setting-item">
                            <span class="setting-label">@Localizer["LanguageSelectorLabel"]</span>
                            <div class="language-switcher" role="group" aria-label="@Localizer["LanguageSelectorLabel"]">
                                @foreach (var culture in AppLocalizer.SupportedCultures)
                                {
                                    <button class="@GetCultureClass(culture.Name)"
                                            type="button"
                                            @onclick="() => ChangeCulture(culture.Name)">
                                        @Localizer.GetCultureDisplayName(culture)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            
            <div class="customizer-footer">
                <button class="save-modal-button" type="button" @onclick="CloseCustomizer">@Localizer["CloseLabel"]</button>
            </div>
        </div>
    </div>
}
